# ===================== Data (never versioned) =====================
# Raw data is immutable and distributed separately (55 MB, > GitHub 50 MB warning).
# Integrity is checked via the SHA-256 in README.md.
data/raw/*
data/processed/*
!data/**/.gitkeep
*.csv
*.parquet
*.feather
*.xlsx
*.pkl
*.pickle

# ===================== Model artifacts =====================
*.joblib
*.onnx
mlruns/

# ===================== Generated outputs =====================
# Figures are regenerated by the pipeline; keep only the folder.
reports/figures/*
!reports/figures/.gitkeep

# ===================== Python =====================
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ===================== Environments & secrets =====================
.venv/
venv/
env/
.env
.env.*

# ===================== Jupyter =====================
.ipynb_checkpoints/

# ===================== IDE / OS =====================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*

# ===================== Claude Code (local) =====================
.claude/settings.local.json
